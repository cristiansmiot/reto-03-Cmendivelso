# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# --- Proveedor LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5

# --- Servidor ---
PORT=3000

# --- Control de costo y robustez ---
MAX_ITER=25
MAX_TOKENS_SESION=200000
MAX_TOKENS_RESPUESTA=2048
LLM_TIMEOUT_MS=60000
